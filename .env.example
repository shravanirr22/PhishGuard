# Environment Variables for PhishGuard
# Copy this file to .env and modify as needed

# Flask server port (default: 5000)
PORT=5000

# Flask secret key (change this in production)
FLASK_SECRET_KEY=phishguard-dev-secret-change-in-production

# Dataset configuration
DATASET_PATH=data/phishing_dataset.csv
TARGET_COLUMN=Result
# URL_COLUMN=url   # Uncomment if dataset has raw URLs instead of pre-extracted features
